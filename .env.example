
# Realtime provider
REALTIME_PROVIDER=xai

# xAI API
XAI_API_KEY=your_xai_api_key_here

# Optional
XAI_MODEL=grok-voice

# App
PORT=3000
NODE_ENV=development

# Long-term memory. Local development defaults to .data/memory.json.
# Railway/production requires PostgreSQL and the migration: npm run db:migrate
DATABASE_URL=
MEMORY_FILE_PATH=.data/memory.json
