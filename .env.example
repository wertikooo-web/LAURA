
# Realtime provider: mock, grok, or gemini. REALTIME_PROVIDER remains a supported alias.
REALTIME_VOICE_PROVIDER=mock

# Grok Voice (server-side only). Legacy XAI_* names remain supported.
GROK_API_KEY=
GROK_VOICE_MODEL=grok-voice-latest
GROK_VOICE_ID=eve

# Gemini Live (server-side only)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE_ID=Aoede

# App
PORT=3000
NODE_ENV=development

# Long-term memory. Local development defaults to .data/memory.json.
# Railway/production requires PostgreSQL and the migration: npm run db:migrate
DATABASE_URL=
MEMORY_FILE_PATH=.data/memory.json
